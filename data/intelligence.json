    {
      "id": "compat",
      "title": "DSH 插件兼容体检",
      "layer": "quality",
      "priority": "优先做小实验",
      "summary": "框架持续变，先帮插件作者知道哪里会坏。",
      "why": "Agent / Inbox API 与会话格式有明确迁移；兼容性是有来源支撑的问题。",
      "reuse": "复用官方运行时与插件接口，新增版本矩阵、最小回归任务和失败报告。",
      "buyer": "维护多个插件的作者与内部 Agent 团队。",
      "mvp": "选 5 个自愿参与的插件、2 个框架版本；输出安装、启动、核心任务的失败定位。",
      "risk": "官方可能补齐；小作者未必愿付费，先验证节省的维护时间。",
      "validation": "人工完成一轮迁移报告，请维护者确认是否减少排障，并验证付费意愿。",
      "sources": [
